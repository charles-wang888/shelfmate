# Copy to .env next to docker-compose.yml if you want overrides:
#   cp .env.docker.example .env

FRONTEND_PORT=8080
BACKEND_PORT=8000
WEAVIATE_HTTP_PORT=8088
WEAVIATE_GRPC_PORT=50058
OLLAMA_PORT=11434

WEAVIATE_API_KEY=shelfmate-dev-key
AUTH_SECRET=shelfmate-dev-secret-change-me

OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=qwen3-embedding

# Auto-embed policies into Weaviate when collection is empty
SHELFMATE_AUTO_REINDEX=1
